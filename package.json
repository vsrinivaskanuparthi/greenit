{
  "name": "green-it-insights",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "scan": "node --import tsx packages/cli/src/index.ts",
    "dev": "node --import tsx apps/api/src/server.ts",
    "build": "tsc --noEmit && vite build --config apps/web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "samples": "node --import tsx scripts/samples.ts",
    "predev": "npm run build && npm run samples",
    "benchmark:express": "node --import tsx scripts/express-benchmark.ts"
  },
  "dependencies": {
    "@babel/parser": "^7.28.0",
    "@babel/traverse": "^7.28.0",
    "@tgwf/co2": "0.18.0",
    "better-sqlite3": "^11.10.0",
    "express": "^5.1.0",
    "ignore": "^7.0.0",
    "multer": "^2.0.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "yauzl": "^3.2.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.20.7",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/yauzl": "^2.10.3",
    "@types/yazl": "^3.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "playwright": "^1.55.0",
    "prettier": "^3.9.9",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^6.3.0",
    "yazl": "^3.3.0"
  }
}
